# Copy this file to .env in the application directory.

# Bind address and port for the interface and API.
HOST=127.0.0.1
PORT=3000

# Runtime data paths are relative to the application directory.
DATA_DIR=data
# ACCOUNTS_FILE=data/accounts.json
# TARGETS_FILE=data/targets.json
# USER_DATA_DIR=data/users

# Generate an active key before starting the server. See Account data encryption in README.md.
WORKSPACE_ENCRYPTION_ENABLED=true
ENCRYPTION_KEYS_DIR=data/keys

# To enable HTTPS, uncomment all three settings after installing the certificate and key.
# HTTPS_ENABLED=true
# TLS_CERT_FILE=data/tls/cert.pem
# TLS_KEY_FILE=data/tls/key.pem
